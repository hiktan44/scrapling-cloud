APP_NAME=Scrapling Cloud
APP_URL=https://scrape.seymata.com
API_URL=https://api.scrape.seymata.com

POSTGRES_DB=scrapling_cloud
POSTGRES_USER=scrapling
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+psycopg://scrapling:replace-with-strong-password@postgres:5432/scrapling_cloud
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-random-string

# Production hardening (required):
# - ENVIRONMENT=production locks the public demo account and rejects default
#   admin credentials.
# - SEED_DEMO stays false. If you ever want a demo workspace, set
#   SEED_DEMO=true together with a private, strong DEMO_PASSWORD.
# - ADMIN_PASSWORD / ADMIN_API_KEY must be set to private values, otherwise
#   the admin account stays locked and no admin key is issued.
ENVIRONMENT=production
SEED_DEMO=false
DEMO_PASSWORD=
ADMIN_EMAIL=admin@scrapling.cloud
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_API_KEY=replace-with-long-random-admin-key

STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_starter
STRIPE_PRICE_GROWTH=price_replace_growth
STRIPE_PRICE_SCALE=price_replace_scale

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_PROVIDER=zai
Z_AI_API_KEY=
# Alternatif LLM: Moonshot Kimi (platform.moonshot.ai) - LLM_PROVIDER=kimi ile aktif olur
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1

PROXY_PROVIDER_URL=
PROXY_PROVIDER_TOKEN=

NEXT_PUBLIC_API_URL=https://api.scrape.seymata.com
